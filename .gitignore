# 一時ファイル・セッションログ
tmp/
etc/

# 先頭 _ は全階層で管理外（_data/ の DB も _secrets/ もここで除外される）
_*

# ビルド出力
dist/

# Node
node_modules/

# 実行ファイルは追跡しない。置いてあるのはビルドで作り直せるもの
# （aichat-cs ・ -rs ・ -go）と、外から持ってきたもの（node.exe のコピー・WinSW 本体）
# 配布したいものが出たら !name.exe で名指しして戻す
*.exe
*.pdb

# サービスのログ
logs/

# Claude Code（チームで共有するものだけ名指しで許可する）
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/
