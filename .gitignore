# 一時ファイル・セッションログ
tmp/
etc/

# 先頭 _ は全階層で管理外（_data/ の DB も _secrets/ もここで除外される）
_*

# ビルド出力
dist/

# Node
node_modules/

# サービス用にコピーした実行ファイル（node.exe のコピーと WinSW 本体）
node-ai-chat-lite.exe
node-ai-chat-lite-winsw.exe

# C# 版 CLI のビルド出力。tools/20_build/build-aichat.cmd で作り直せる
aichat.exe
aichat.pdb

# サービスのログ
logs/

# Claude Code（チームで共有するものだけ名指しで許可する）
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/
